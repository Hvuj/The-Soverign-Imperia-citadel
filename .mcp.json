{
  "mcpServers": {
    "sovereign-imperia-citadel": {
      "command": "python3",
      "args": ["tools/citadel_mcp_server.py"]
    },
    "citadel-retrieval": {
      "command": "python",
      "args": ["-m", "citadel.mcp.server"],
      "env": {
        "PYTHONPATH": "src",
        "CITADEL_REDIS_URL": "redis://127.0.0.1:6379"
      }
    }
  }
}
