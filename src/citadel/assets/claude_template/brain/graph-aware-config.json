{
  "version": 7,
  "automation_mode": "mandatory",
  "normal_start_command": "scripts/claude-start-smart.sh",
  "direct_claude_start_allowed": false,
  "manual_commands_are_debug_only": true,
  "daemon_required": true,
  "default_depth": 2,
  "max_context_nodes": 12,
  "max_memory_refs": 8,
  "max_files": 20,
  "max_agents": 8,
  "max_agents_by_intent": {
    "docs_ingestion": 5,
    "question": 5,
    "workflow": 5,
    "validation": 6,
    "implementation": 8,
    "debugging": 8
  },
  "max_skills": 8,
  "_comment": "Workspace-agnostic routing scaffold. The topic/domain/unit tables below use GENERIC capability categories only; the concrete framework/domain vocabulary for a given workspace is learned over time (see framework-signals.json and the graph-aware router) and merged in per workspace. No prior-domain terms are shipped.",
