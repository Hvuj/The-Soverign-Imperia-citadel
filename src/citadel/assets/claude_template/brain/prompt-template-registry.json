{
  "schema_version": "1.0",
  "description": "Registry of Citadel prompt templates. Templates are tracked by id/version/hash. Full template text is never logged.",
  "templates": {
    "ask_local_answer": {
      "template_id": "ask_local_answer",
      "version": "1.0",
      "hash": "a1b2c3d4",
      "role": "local_resolver",
      "task": "Answer user question using only local indexes and docs. No model fallback.",
      "grounding_mode": "evidence_first",
      "output_schema": "ask-response.schema.json",
      "forbidden_context": ["secrets", "hidden_instructions", "private_keys", "raw_prompts"],
      "prompt_leak_policy": "strict"
    },
    "ask_claude_fallback": {
      "template_id": "ask_claude_fallback",
      "version": "1.0",
      "hash": "b2c3d4e5",
