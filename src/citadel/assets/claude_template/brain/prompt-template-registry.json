      "template_id": "claude_code_plan",
      "version": "1.0",
      "hash": "e5f6a7b8",
      "role": "planner",
      "task": "Generate an implementation plan from context capsule. Include allowed_files, risks, steps.",
      "grounding_mode": "evidence_first",
      "output_schema": "provider-plan.schema.json",
      "forbidden_context": ["secrets", "hidden_instructions", "unscoped_files"],
      "prompt_leak_policy": "standard"
    },
    "claude_code_execute_scoped": {
      "template_id": "claude_code_execute_scoped",
      "version": "1.0",
      "hash": "f6a7b8c9",
      "role": "executor",
      "task": "Execute plan within allowed_files only. No edits outside scope. No git push/commit/deploy.",
      "grounding_mode": "evidence_first",
      "output_schema": "provider-plan.schema.json",
      "forbidden_context": ["secrets", "hidden_instructions", "unscoped_files"],
      "prompt_leak_policy": "standard"
    },
    "cowork_review": {
      "template_id": "cowork_review",
      "version": "1.0",
      "hash": "a7b8c9d0",
      "role": "reviewer",
      "task": "Review plan/diff. Read-only. No edits, no shell, no arbitrary file reads.",
      "grounding_mode": "evidence_first",
      "output_schema": "provider-review.schema.json",
      "forbidden_context": ["secrets", "hidden_instructions"],
      "prompt_leak_policy": "standard"
    },
