      "output_schema": "ask-response.schema.json",
      "forbidden_context": ["secrets", "hidden_instructions"],
      "prompt_leak_policy": "strict"
    },
    "forbidden_action_refusal": {
      "template_id": "forbidden_action_refusal",
      "version": "1.0",
      "hash": "b4c5d6e7",
      "role": "refusal_handler",
      "task": "Safely refuse requests to run commands, edit files, or bypass approval through Ask Citadel.",
