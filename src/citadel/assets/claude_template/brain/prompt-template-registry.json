      "task": "Answer user question using local context plus one bounded model call. No tools, no edits, no shell.",
      "grounding_mode": "evidence_first",
      "output_schema": "ask-response.schema.json",
      "forbidden_context": ["secrets", "hidden_instructions", "private_keys", "raw_prompts"],
      "prompt_leak_policy": "strict"
    },
    "quote_first_analysis": {
      "template_id": "quote_first_analysis",
      "version": "1.0",
      "hash": "c3d4e5f6",
      "role": "source_analyst",
