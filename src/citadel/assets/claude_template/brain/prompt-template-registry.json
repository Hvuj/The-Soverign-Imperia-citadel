      "grounding_mode": "evidence_first",
      "output_schema": "ask-response.schema.json",
      "forbidden_context": ["secrets", "hidden_instructions"],
      "prompt_leak_policy": "strict"
    },
    "implementation_final_report": {
      "template_id": "implementation_final_report",
      "version": "1.0",
      "hash": "d0e1f2a3",
