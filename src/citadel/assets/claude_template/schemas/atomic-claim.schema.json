{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AtomicClaim",
  "type": "object",
  "properties": {
    "claim_id": { "type": "string", "pattern": "^clm_[a-f0-9]{8}$" },
    "text": { "type": "string", "minLength": 5 },
    "provenance_span": { "$ref": "provenance-span.schema.json" },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
  },
  "required": ["claim_id", "text", "provenance_span", "confidence"],
  "additionalProperties": false
}
