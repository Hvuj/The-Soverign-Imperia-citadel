{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "workspace-summary.schema.json",
  "title": "WorkspaceSummary",
  "description": "Schema for /api/workspace/summary response.",
  "type": "object",
  "required": ["workspace_root", "repos", "total_files", "total_modules", "total_symbols", "index_freshness_seconds", "build_metadata"],
  "properties": {
    "workspace_root": { "type": "string" },
    "repos": {
      "type": "array",
      "items": { "type": "string" }
    },
    "total_files": { "type": "integer", "minimum": 0 },
    "total_modules": { "type": "integer", "minimum": 0 },
    "total_symbols": { "type": "integer", "minimum": 0 },
    "total_tests": { "type": "integer", "minimum": 0 },
    "total_features": { "type": "integer", "minimum": 0 },
    "index_freshness_seconds": { "type": "number" },
    "build_metadata": {
      "type": "object",
      "properties": {
        "build_id": { "type": "string" },
        "built_at": { "type": "string" },
        "build_duration_sec": { "type": "number" },
        "incremental": { "type": "boolean" },
        "repo_count": { "type": "integer" },
        "file_count": { "type": "integer" }
      }
    }
  }
}
