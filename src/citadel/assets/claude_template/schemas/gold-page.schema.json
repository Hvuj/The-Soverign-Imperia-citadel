{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoldPage",
  "type": "object",
  "properties": {
    "concept_name": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "source_hashes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "status": { "type": "string", "enum": ["active", "contested", "superseded"] },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "job_id": { "type": "string" },
          "gate_score": { "type": "number" }
        },
        "required": ["timestamp", "job_id", "gate_score"]
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": { "type": "string" },
          "justification": { "type": "string" }
        },
        "required": ["target", "justification"]
      }
    }
  },
  "required": ["concept_name", "tags", "source_hashes", "status", "revision_history", "related"],
  "additionalProperties": false
}
