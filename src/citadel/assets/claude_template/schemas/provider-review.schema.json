{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "provider-review.schema.json",
  "title": "ProviderReview",
  "description": "Schema for AI provider code/plan review outputs.",
  "type": "object",
  "required": ["review_id", "provider", "verdict", "findings", "created_at"],
  "properties": {
    "review_id": { "type": "string" },
    "provider": { "type": "string", "enum": ["claude_code", "cowork", "anthropic_sdk", "local"] },
    "task_id": { "type": "string" },
    "verdict": {
      "type": "string",
      "enum": ["approved", "approved_with_notes", "needs_changes", "blocked", "error"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "description"],
        "properties": {
          "severity": { "type": "string", "enum": ["info", "warning", "error", "blocking"] },
          "description": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "suggestion": { "type": "string" }
        }
      }
    },
    "summary": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "evidence": { "type": "array", "items": { "type": "string" } }
  }
}
