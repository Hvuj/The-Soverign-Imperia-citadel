{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TeamReport",
  "type": "object",
  "properties": {
    "task_id": { "type": "string" },
    "team": {
      "type": "string",
      "enum": ["workflow", "tools", "skills", "artifacts", "validation", "memory", "routing"]
    },
    "contract_satisfiable": { "type": "boolean" },
    "missing": { "type": "array", "items": { "type": "string" } },
    "cheapest_path": { "type": "string" },
    "cost_estimate": { "type": "number" }
  },
  "required": ["task_id", "team", "contract_satisfiable", "missing", "cheapest_path", "cost_estimate"],
  "additionalProperties": false
}
