# Copy to `.env` beside docker-compose.yml and edit. All values have safe defaults.

# ── Redis: LOCAL vs CLOUD ────────────────────────────────────────────────────────────────────
# LOCAL (default): run our managed Redis Stack container. Include the profile when you bring the stack up:
#     docker compose --profile local-redis up -d
#   (or set COMPOSE_PROFILES=local-redis below so a plain `docker compose up -d` includes it.)
# CLOUD: point at a managed Redis and DON'T run the local one — leave the profile off and set the URL:
#     CITADEL_REDIS_URL=rediss://user:pass@your-host:6379
COMPOSE_PROFILES=local-redis
CITADEL_REDIS_URL=
CITADEL_REDIS_PORT=6379

# ── MCP retrieval server ─────────────────────────────────────────────────────────────────────
# Absolute path to the workspace the server indexes (mounted read-only).
CITADEL_WORKSPACE_HOST=../..
CITADEL_MCP_PORT=8848

# Embedding model the server asks Ollama for.
CITADEL_EMBED_MODEL=nomic-embed-text

# ── Fetch/Context7 egress allowlist (enforce via a proxy or host firewall on citadel_egress) ──
CITADEL_FETCH_ALLOWLIST=docs.python.org,github.com,pypi.org,raw.githubusercontent.com
